#!/bin/sh
# Generate a double-clickable .app that launches a CrossOver game on native NVK.
#
#   sh nvk-mkapp.sh --bottle Steam \
#       --app 'C:\Program Files (x86)\Steam\steamapps\common\Deadlock\game\bin\win64\deadlock.exe' \
#       --name 'Deadlock (NVK)' --args '-dx11' --needs-steam \
#       --icon-from '/path/to/some.app'
#
# The generated app logs everything to ~/Library/Logs/nvk-<name>.log and shows a
# dialog if anything fails, because a GUI app has no terminal to print to.
#
# Why a generated .app rather than patching CrossOver's own launchers:
#   * CrossOver regenerates its launchers; edits there do not survive.
#   * macOS strips DYLD_* across hardened-runtime exec boundaries, so the
#     environment must be set in the process that becomes the game, not
#     inherited through Steam's helper chain.
# Built on your machine => no quarantine attribute => no Gatekeeper prompt.

set -eu

RUNTIME=/Library/GPUBundles/nvmtl/wine
CX_ROOT='/Applications/CrossOver.app/Contents/SharedSupport/CrossOver'
BOTTLE_DIRS="/Volumes/Storage/CrossOver/Bottles:$HOME/Library/Application Support/CrossOver/Bottles"
OUTDIR="$HOME/Applications"

bottle=''; app=''; name=''; args=''; needs_steam=no; icon_from=''; steam_app=''
while [ $# -gt 0 ]; do
  case $1 in
    --bottle)      bottle=$2; shift 2 ;;
    --app)         app=$2; shift 2 ;;
    --name)        name=$2; shift 2 ;;
    --args)        args=$2; shift 2 ;;
    --needs-steam) needs_steam=yes; shift ;;
    --steam-app)   steam_app=$2; shift 2 ;;
    --icon-from)   icon_from=$2; shift 2 ;;
    --outdir)      OUTDIR=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done
[ -n "$bottle" ] || { echo "--bottle is required" >&2; exit 1; }
[ -n "$app" ]    || { echo "--app is required" >&2; exit 1; }
[ -n "$name" ]   || name=$(basename "$app" .exe)
[ -n "$steam_app" ] || steam_app='C:\Program Files (x86)\Steam\steam.exe'

[ "$(id -u)" -ne 0 ] || { echo "do not run this as root" >&2; exit 1; }
[ -x "$RUNTIME/bin/nvk-runtime" ] || { echo "NVK runtime missing: $RUNTIME" >&2; exit 1; }
[ -x "$CX_ROOT/bin/wine" ] || { echo "CrossOver missing: $CX_ROOT" >&2; exit 1; }

prefix=''
IFS=:; for d in $BOTTLE_DIRS; do [ -d "$d/$bottle" ] && prefix="$d/$bottle"; done; unset IFS
[ -n "$prefix" ] || { echo "bottle '$bottle' not found" >&2; exit 1; }

slug=$(printf '%s' "$name" | tr -cd '[:alnum:]')
bundle="$OUTDIR/$name.app"
rm -rf "$bundle"
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"

icon_line=''
if [ -n "$icon_from" ]; then
  src=$(find "$icon_from" -name '*.icns' 2>/dev/null | head -1 || true)
  if [ -n "$src" ]; then
    cp "$src" "$bundle/Contents/Resources/app.icns"
    icon_line='  <key>CFBundleIconFile</key><string>app</string>'
    echo "icon: $src"
  else
    echo "note: no .icns under $icon_from - using the default icon"
  fi
fi

cat > "$bundle/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>$name</string>
  <key>CFBundleDisplayName</key><string>$name</string>
  <key>CFBundleExecutable</key><string>launch</string>
  <key>CFBundleIdentifier</key><string>local.nvk.$slug</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.2</string>
  <key>NSHighResolutionCapable</key><true/>
$icon_line
</dict></plist>
PLIST

cat > "$bundle/Contents/MacOS/launch" <<LAUNCH
#!/bin/sh
# Generated by nvk-mkapp.sh
RUNTIME='$RUNTIME'
CX_ROOT='$CX_ROOT'
PREFIX='$prefix'
BOTTLE='$bottle'
APP='$app'
ARGS='$args'
NEEDS_STEAM='$needs_steam'
STEAM_APP='$steam_app'
LOG="\$HOME/Library/Logs/nvk-$slug.log"

# launchd gives GUI apps a minimal environment; set a usable PATH ourselves.
PATH="\$CX_ROOT/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# CrossOver's --bottle only searches its default bottle directories. A GUI app
# gets a stripped environment, so point it at wherever this bottle actually is.
CX_BOTTLE_PATH=\$(/usr/bin/dirname "\$PREFIX")
export PATH CX_ROOT CX_BOTTLE_PATH
export WINEMSYNC=1

mkdir -p "\$HOME/Library/Logs" "\$PREFIX/drive_c/dxvk"
: > "\$LOG"
exec >>"\$LOG" 2>&1
echo "=== \$(date) : $name ==="
printf 'prefix=%s\\n' "\$PREFIX"
printf 'app=%s %s\\n' "\$APP" "\$ARGS"
printf 'CX_BOTTLE_PATH=%s\\n' "\$CX_BOTTLE_PATH"

fail() {
  echo "FAILED: \$1"
  /usr/bin/osascript -e "display dialog \"\$1\n\nLog: \$LOG\" with title \"$name\" buttons {\"OK\"} default button 1 with icon stop" >/dev/null 2>&1
  exit 1
}

CXW="\$CX_ROOT/bin/wine"
[ -x "\$CXW" ] || fail "CrossOver's wine not found at \$CXW"

cd "\$PREFIX/drive_c" || fail "cannot cd to \$PREFIX/drive_c"

steam_up() { /usr/bin/pgrep -f 'steamwebhelper' >/dev/null 2>&1; }

if [ "\$NEEDS_STEAM" = yes ]; then
  if steam_up; then
    echo "Steam already running."
  else
    echo "starting Steam..."
    env WINEPREFIX="\$PREFIX" DYLD_LIBRARY_PATH="\$RUNTIME/lib" DXVK_LOG_PATH='C:\\dxvk' \\
        "\$CXW" --bottle "\$BOTTLE" --cx-app "\$STEAM_APP" &
    n=0
    while [ \$n -lt 120 ]; do
      steam_up && break
      sleep 1; n=\$((n+1))
    done
    steam_up || fail "Steam did not finish starting within 120s. See the log for what wine printed."
    echo "Steam up after \${n}s; settling..."
    sleep 8
  fi
fi

echo "launching game..."
# NOTE: no 'exec' here - nvk_env used to be a shell function and exec cannot
# replace the shell with a function. Call it plainly and check the status.
# shellcheck disable=SC2086
env WINEPREFIX="\$PREFIX" DYLD_LIBRARY_PATH="\$RUNTIME/lib" DXVK_LOG_PATH='C:\\dxvk' \\
    "\$CXW" --bottle "\$BOTTLE" --cx-app "\$APP" \$ARGS
rc=\$?
echo "game exited rc=\$rc"
[ \$rc -eq 0 ] || fail "The game exited with status \$rc."
LAUNCH

chmod +x "$bundle/Contents/MacOS/launch"
touch "$bundle"

echo "created: $bundle"
echo "log:     ~/Library/Logs/nvk-$slug.log"
